+    trips = sum(r["往復回数"] for r in agents)
+    logs = len({(r["セッションID"], r["記録元"]) for r in agents})
+    print("  担当エージェントだけ: API 往復 %s 回 / 記録 %d本"
+          % ("{:,}".format(trips), logs))
