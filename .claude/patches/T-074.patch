+class Responses:
+    """usage を持つ行を `requestId` で束ね、モデルの応答1回ぶんにする。 (T-074)
+
+    1回の応答は複数行に分かれて記録される。同じ `requestId` の行は入力と
+    キャッシュの値が全行同じで、出力だけが伸びて最後の行が完全な値になる。
+    だから最初の行をそのまま採り、出力だけを後から来た行で上書きする。
+
+    `requestId` が無い行は束ねない。鍵が無いものをまとめると、別々の往復が
+    1つに潰れて過小計上になる（過大計上を直すはずが逆向きに外れる）。
+    """
+
+    def __init__(self) -> None:
+        self._items: dict = {}
+        self._loose = 0          # 鍵の無い行に振る通し番号
+
+    def feed(self, entry: dict, model: str, counts: dict, context=None) -> None:
+        request_id = entry.get("requestId")
+        if request_id:
+            key = ("応答", request_id)
+        else:
+            self._loose += 1
+            key = ("行", self._loose)
+
+        item = self._items.get(key)
+        if item is None:
+            # context（メインセッションでのタスクの紐付け）は、その応答が
+            # 始まった時点の値で固定する。応答の途中でタスクIDが変わっても、
+            # 1つの応答を2つに割って入力とキャッシュを二重に数えないため。
+            self._items[key] = {"model": model, "counts": dict(counts),
+                                "context": context}
+            return
+        item["counts"]["出力"] = counts["出力"]
+
+    def __iter__(self):
+        return iter(self._items.values())
 
 
