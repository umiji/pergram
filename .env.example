# 写して .env.local を作る。.env.local は .gitignore 済み。
# 値の出所と読み方は scripts/rakuten_api.js の readCredentials ひとつ。

# 楽天ウェブサービス。2026-02-10 の認証基盤刷新で4つ要るようになった。
# 収集（collect:rakuten）と価格更新（prices:refresh）の両方が使う。
RAKUTEN_APP_ID=          # UUID 形式。旧19桁の数字ではない
RAKUTEN_ACCESS_KEY=      # pk_ で始まる
RAKUTEN_APP_URL=         # 楽天に登録したアプリ URL。Referer に載せる

# 🔒 アフィリエイト ID。prices:refresh は無いと実行前に停止する。
#    公開中の購入リンクを素の商品 URL で全上書きしてしまうため。
RAKUTEN_AFFILIATE_ID=

# GA4。未設定ならビルドは計測タグを入れない
GA4_MEASUREMENT_ID=

# LLM 後処理（scripts/enrich_draft.js）をモデルに繋ぐときだけ要る
ANTHROPIC_API_KEY=
